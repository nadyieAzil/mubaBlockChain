# ==============================================================================
# SuiPact — Environment Template (SAFE TO COMMIT TO GITHUB)
# Copy this file to '.env' and populate with your own keys and endpoints.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend & Sponsor Relayer Settings
# ------------------------------------------------------------------------------
PORT=3001

# Sui Testnet RPC & GraphQL endpoints
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_GRAPHQL_URL=https://sui-testnet.mystenlabs.com/graphql

# Deployer / Sponsor Private Key (suiprivkey... or base64 format)
# Required for backend gas sponsorship
SPONSOR_PRIVATE_KEY=suiprivkey1...your_private_key_here...

# ------------------------------------------------------------------------------
# Frontend Public Settings (Exposed to Next.js Client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443
NEXT_PUBLIC_SUI_GRAPHQL_URL=https://sui-testnet.mystenlabs.com/graphql

# Smart Contract IDs (Sui Move Package)
NEXT_PUBLIC_PACKAGE_ID=0x8c57edf140ac229fb7e11652e8d9dcded7fd63dda683adfd7fd9c5bed1db5a18
NEXT_PUBLIC_PACKAGE_ID_V1=0x86edb7211b5b15566739b5a0ae689a669c590a7b0580cbf967c8fd1bc828f1a1
NEXT_PUBLIC_UPGRADE_CAP_ID=0x377bfe72994ed7f9816118ba012f200b0aacee9c5a2c8b39a949ed7e679fbb11

# Deployment Transaction Digests
NEXT_PUBLIC_PUBLISH_TX_DIGEST=3teRC52TQvDgh9YAVmmoDJvQqMtgUzzpnJgA5QqtQTYf
NEXT_PUBLIC_UPGRADE_TX_DIGEST=9yJyrnivjB7LfTgQUobfooZoXezAuTkRp2g761VX537p

# Sponsor Address (Public address corresponding to SPONSOR_PRIVATE_KEY)
NEXT_PUBLIC_SPONSOR_ADDRESS=0xaf39410b7ef60d0de77312789647ca1a9989784229b275d5a7866e4a610e7771

# Gas Relayer Backend URL
NEXT_PUBLIC_RELAYER_URL=http://localhost:3001

# Testnet USDC Type Definition
NEXT_PUBLIC_TESTNET_USDC_TYPE=0xa1ec7fc00a6f40db9693ad1415d880f9879785369065b2370007891866ad34a2::wusdc::WUSDC

# OpenRouter AI Configuration
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001

